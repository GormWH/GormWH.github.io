---
import MetaRefresh from "@components/MetaRefresh.astro";
import { getCollection } from "astro:content";
import type { GetStaticPaths } from "astro";
import { DEFAULT_LOCALE, getLocaleFromId, getSlugFromId, localizedPath } from "@lib/i18n";

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = await getCollection("work", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  // Derived from the en-us content, not hardcoded — future English work
  // entries automatically get a legacy stub without touching this file.
  const slugs = entries
    .filter((entry) => getLocaleFromId(entry.id) === DEFAULT_LOCALE)
    .map((entry) => getSlugFromId(entry.id));
  return slugs.map((slug) => ({ params: { slug } }));
};

const { slug } = Astro.params as { slug: string };
const path = localizedPath(DEFAULT_LOCALE, 'work', slug);
---

<MetaRefresh path={path} />
