---
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import ArticleHeader from "@components/ArticleHeader.astro";
import ArticlePager from "@components/ArticlePager.astro";
import CollectionSidebar from "@components/CollectionSidebar.astro";
import CollectionToc from "@components/CollectionToc.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { buildBlogPostingSchema, absoluteUrl, DEFAULT_OG_IMAGE } from "@lib/seo";
import {
  LOCALE_PATHS,
  localizedPath,
  distinctSlugs,
  resolveEntry,
  hreflangAlternates,
} from "@lib/i18n";
import type { ResolvedEntry } from "@lib/i18n";

interface SlugResolved {
  slug: string;
  resolved: ResolvedEntry<CollectionEntry<"writing">>;
}

interface Props {
  resolved: ResolvedEntry<CollectionEntry<"writing">>;
  slug: string;
  next: SlugResolved | null;
  sidebarEntries: CollectionEntry<"writing">[];
  rawEntries: CollectionEntry<"writing">[];
}

export const getStaticPaths: GetStaticPaths = async () => {
  // Nested (not a sibling top-level declaration) — see work/[slug].astro's
  // comment: a helper defined outside this closure was tree-shaken away by
  // Astro's minimal getStaticPaths build chunk even though it's called from
  // inside here.
  function compareWriting(a: CollectionEntry<"writing">, b: CollectionEntry<"writing">) {
    const imp = Number(b.data.important) - Number(a.data.important);
    if (imp !== 0) return imp;
    const dateDiff = b.data.date.getTime() - a.data.date.getTime();
    if (dateDiff !== 0) return dateDiff;
    return a.id < b.id ? -1 : a.id > b.id ? 1 : 0;
  }

  const rawEntries = await getCollection("writing", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  const slugs = distinctSlugs(rawEntries);

  return LOCALE_PATHS.flatMap((lang) => {
    const resolvedList: SlugResolved[] = slugs
      .map((slug) => ({ slug, resolved: resolveEntry(rawEntries, slug, lang) }))
      .filter((r): r is SlugResolved => r.resolved !== null)
      .sort((a, b) => compareWriting(a.resolved.entry, b.resolved.entry));

    return resolvedList.map(({ slug, resolved }, idx) => ({
      params: { lang, slug },
      props: {
        resolved,
        slug,
        next: resolvedList[idx + 1] ?? null,
        sidebarEntries: resolvedList.map((r) => r.resolved.entry),
        rawEntries,
      },
    }));
  });
};

const { lang } = Astro.params as { lang: string };
const { resolved, slug, next, sidebarEntries, rawEntries } = Astro.props;
const { entry, isFallback, sourceLocalePath } = resolved;
const { Content, headings } = await render(entry);

const date = entry.data.date.toISOString().slice(0, 10);
const tagsStr = entry.data.tags.join(" · ");
const metaGrid = [
  { label: "Date", value: date },
  { label: "Kind", value: entry.data.kind },
  ...(tagsStr ? [{ label: "Tags", value: tagsStr }] : []),
];

const writingJsonLd = buildBlogPostingSchema({
  url: absoluteUrl(localizedPath(lang, 'writing', slug), Astro.site),
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date,
  image: absoluteUrl(DEFAULT_OG_IMAGE, Astro.site),
});

// Every locale x slug combination is generated (fallback-rendered when no
// translation exists), so the switcher can point straight at the same slug
// under each locale without ever 404ing.
const switcherHrefs = Object.fromEntries(
  LOCALE_PATHS.map((l) => [l, localizedPath(l, 'writing', slug)]),
);

// exactOptionalPropertyTypes: omit the `canonical` key entirely for real
// entries rather than passing an explicit `undefined`.
const canonicalProp = isFallback
  ? { canonical: absoluteUrl(localizedPath(sourceLocalePath, 'writing', slug), Astro.site) }
  : {};
const alternates = isFallback ? [] : hreflangAlternates('writing', slug, rawEntries, Astro.site);
---

<MarkdownLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={lang}
  isFallback={isFallback}
  alternates={alternates}
  switcherHrefs={switcherHrefs}
  {...canonicalProp}
  seo={{
    articleType: 'BlogPosting',
    jsonLd: writingJsonLd,
    publishedTime: entry.data.date.toISOString(),
    tags: entry.data.tags,
  }}
>
  <CollectionSidebar
    slot="left"
    entries={sidebarEntries}
    collection="writing"
    currentEntry={entry}
    locale={lang}
  />
  <CollectionToc slot="right" headings={headings} />

  <ArticleHeader
    back={{ href: localizedPath(lang, 'writing'), label: "all writing" }}
    metaLeft={date}
    metaRight={entry.data.kind}
    title={entry.data.title}
    lead={entry.data.description}
    metaGrid={metaGrid}
  />
  <div class="gh-prose">
    <Content />
  </div>
  {
    next && (
      <ArticlePager
        next={{
          href: localizedPath(lang, 'writing', next.slug),
          title: next.resolved.entry.data.title,
        }}
      />
    )
  }
</MarkdownLayout>
