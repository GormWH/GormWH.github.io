---
import MarkdownLayout from "@layouts/MarkdownLayout.astro";
import ArticleHeader from "@components/ArticleHeader.astro";
import ArticlePager from "@components/ArticlePager.astro";
import CollectionSidebar from "@components/CollectionSidebar.astro";
import CollectionToc from "@components/CollectionToc.astro";
import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";
import type { GetStaticPaths } from "astro";
import { buildBlogPostingSchema, absoluteUrl, DEFAULT_OG_IMAGE } from "@lib/seo";
import {
  localizedPath,
  hreflangAlternates,
  switcherHrefsFor,
  buildLocalizedDetailPaths,
} from "@lib/i18n";
import type { LocalizedDetailProps } from "@lib/i18n";
import { compareEntryPriority } from "@lib/entryRank";

type Props = LocalizedDetailProps<CollectionEntry<"writing">>;

export const getStaticPaths: GetStaticPaths = async () => {
  const rawEntries = await getCollection("writing", ({ data }) =>
    import.meta.env.PROD ? !data.draft : true,
  );
  return buildLocalizedDetailPaths(rawEntries, compareEntryPriority);
};

const { lang } = Astro.params as { lang: string };
const { resolved, slug, next, sidebarEntries, rawEntries } = Astro.props;
const { entry, isFallback, sourceLocalePath } = resolved;
const { Content, headings } = await render(entry);

const date = entry.data.date.toISOString().slice(0, 10);
const tagsStr = entry.data.tags.join(" · ");
const metaGrid = [
  { label: "Date", value: date },
  { label: "Kind", value: entry.data.kind },
  ...(tagsStr ? [{ label: "Tags", value: tagsStr }] : []),
];

const writingJsonLd = buildBlogPostingSchema({
  url: absoluteUrl(localizedPath(lang, 'writing', slug), Astro.site),
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.date,
  image: absoluteUrl(DEFAULT_OG_IMAGE, Astro.site),
});

const switcherHrefs = switcherHrefsFor('writing', slug);

// exactOptionalPropertyTypes: omit the `canonical` key entirely for real
// entries rather than passing an explicit `undefined`.
const canonicalProp = isFallback
  ? { canonical: absoluteUrl(localizedPath(sourceLocalePath, 'writing', slug), Astro.site) }
  : {};
const alternates = isFallback ? [] : hreflangAlternates('writing', slug, rawEntries, Astro.site);
---

<MarkdownLayout
  title={entry.data.title}
  description={entry.data.description}
  locale={lang}
  isFallback={isFallback}
  alternates={alternates}
  switcherHrefs={switcherHrefs}
  {...canonicalProp}
  seo={{
    articleType: 'BlogPosting',
    jsonLd: writingJsonLd,
    publishedTime: entry.data.date.toISOString(),
    tags: entry.data.tags,
  }}
>
  <CollectionSidebar
    slot="left"
    entries={sidebarEntries}
    collection="writing"
    currentEntry={entry}
    locale={lang}
  />
  <CollectionToc slot="right" headings={headings} />

  <ArticleHeader
    back={{ href: localizedPath(lang, 'writing'), label: "all writing" }}
    metaLeft={date}
    metaRight={entry.data.kind}
    title={entry.data.title}
    lead={entry.data.description}
    metaGrid={metaGrid}
  />
  <div class="gh-prose">
    <Content />
  </div>
  {
    next && (
      <ArticlePager
        next={{
          href: localizedPath(lang, 'writing', next.slug),
          title: next.resolved.entry.data.title,
        }}
      />
    )
  }
</MarkdownLayout>
