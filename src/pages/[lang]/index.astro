---
import BaseLayout from "@layouts/BaseLayout.astro";
import { buildPersonSchema, absoluteUrl, DEFAULT_OG_IMAGE } from "@lib/seo";
import { LOCALE_PATHS, DEFAULT_LOCALE, localizedPath, getLocaleInfo } from "@lib/i18n";
import type { HreflangAlternate } from "@lib/i18n";
import { useTranslations } from "@lib/ui";
import type { GetStaticPaths } from "astro";

import Hero from "@features/home/Hero.astro";
import About from "@features/home/About.astro";
import Work from "@features/home/Work.astro";
import Writing from "@features/home/Writing.astro";
import Contact from "@features/home/Contact.astro";

export const getStaticPaths: GetStaticPaths = async () => {
  return LOCALE_PATHS.map((lang) => ({ params: { lang } }));
};

const { lang } = Astro.params as { lang: string };
const t = useTranslations(lang.split('-')[0] ?? 'en');

const personJsonLd = buildPersonSchema({
  url: absoluteUrl(localizedPath(lang), Astro.site),
  image: absoluteUrl(DEFAULT_OG_IMAGE, Astro.site),
});

// The homepage has no "translation" concept in the resolveEntry sense — every
// locale always renders its own homepage — so all three locales join the
// hreflang cluster unconditionally, plus x-default.
const alternates: HreflangAlternate[] = [
  ...LOCALE_PATHS.map((l) => ({
    hreflang: getLocaleInfo(l)!.code,
    href: absoluteUrl(localizedPath(l), Astro.site),
  })),
  { hreflang: 'x-default', href: absoluteUrl(localizedPath(DEFAULT_LOCALE), Astro.site) },
];
---

<BaseLayout title="Gorm — SuHong Park" seo={{ jsonLd: personJsonLd }} locale={lang} alternates={alternates}>
  <Hero locale={lang} t={t} />
  <About locale={lang} t={t} />
  <Work locale={lang} t={t} />
  <Writing locale={lang} t={t} />
  <Contact locale={lang} t={t} />
</BaseLayout>
